# Copy to .env.local and paste values after each account exists.
# Restart `npm run dev` after you save. Put the same names in Vercel before you deploy.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend. RESEND_FROM_EMAIL must be an address on a domain you verified there.
ENABLE_OTP=true
NEXT_PUBLIC_ENABLE_OTP=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Local app URL now. On Vercel, set both to the live domain (https://yourdomain.com).
NEXT_PUBLIC_ROOT_DOMAIN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# PUBLIC_SITE_URL=

# Must match the business slug you seed below. Same value in both lines.
PRIMARY_SUPPORT_BUSINESS_SLUG=
NEXT_PUBLIC_PRIMARY_SUPPORT_BUSINESS_SLUG=

# Used by `npm run seed:admin` to create the one business admin. Fill these, then run the script once.
SEED_BUSINESS_SLUG=
SEED_BUSINESS_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# SEED_ADMIN_FIRST_NAME=
# SEED_ADMIN_LAST_NAME=

# Cloudflare Turnstile. Leave both blank to hide the widget until the widget exists.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Any long random string. Vercel Cron sends it as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Optional. Shared signup / OTP rate limits across servers. Skip until you want Upstash.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional. Fake email domain for older username-only staff accounts. Not a real inbox.
# STAFF_AUTH_EMAIL_DOMAIN=

# Optional. Signups are approved automatically. Set to true to require staff approval.
# MANUAL_SIGNUP_APPROVAL=true
